# NEXUS ai service — environment (§130 one-command dev, §131 never commit secrets)
# Copy to .env (gitignored) or export in the shell. Every value below has a working default in
# code; the two that do NOT are the provider credentials — without them the pool stays `mock`
# and every model call answers from the deterministic mock adapter (DECISIONS D4).

# --- model provider (adapter pool) ---
# mock | openai | anthropic — `openai` works against any Chat-Completions-compatible proxy
NEXUS_LLM_PROVIDER=mock
# No default: must match your proxy (e.g. an OpenAI-compatible /v1 root)
NEXUS_LLM_BASE_URL=
# Never commit a real key — this example file carries the name only
NEXUS_LLM_API_KEY=
NEXUS_LLM_MODEL_CHEAP=gpt-4o-mini
NEXUS_LLM_MODEL_MID=gpt-4o
NEXUS_LLM_MODEL_REASON=o3-mini
# Per-call adapter timeout in seconds (config.py default 45.0)
NEXUS_REQUEST_TIMEOUT_S=45

# --- transport envelope (D1044) ---
# The OpenAI adapter wraps every completion in an SSE stream with
# stream_options.include_usage=true so the provider reports usage (including cache accounting)
# on every call. Callers of complete() still receive ONE complete LLMResponse — nothing streams
# to any client. Default ON; set to false/0/no/off to restore the direct JSON envelope.
NEXUS_LLM_STREAM=true

# --- provider prefix-cache economics (D1037, D1042) ---
# cached_tokens factor applied to cached input tokens when computing cost_usd. 1.0 keeps the
# historical cost shape (cached tokens billed as input). Set < 1.0 (e.g. 0.5, the OpenAI cached-
# input shape) to re-cost cached reads at a discount. The upstream default is 1.0 on purpose.
NEXUS_CACHE_COST_FACTOR=1.0

# --- Redis replay cache for byte-identical temperature-0 requests (D1047, default OFF) ---
# Same discipline as the rails cache: explicit opt-in, lazy client, every failure a miss.
# Replay returns a zero-token LLMResponse with cache_hit=True on byte-identical, temperature-0,
# non-`reason` requests — the round trip itself never happens.
NEXUS_LLM_RESPONSE_CACHE=
# redis://127.0.0.1:6380/0 is the compose-local default
NEXUS_REDIS_URL=redis://127.0.0.1:6380/0
# Non-positive or unparsable values fall back to 3600s
NEXUS_LLM_RESPONSE_CACHE_TTL_S=3600

# --- the deterministic sort-only search rails cache (D1022, opt-in) ---
NEXUS_SEARCH_CACHE=
NEXUS_SEARCH_CACHE_TTL_S=30

# --- live cost ledger floor (see apps/ai/tests/test_live_cost_ledger.py) ---
# CI points the live-DB suite here; local dev leaves it empty and the live arms skip instead.
NEXUS_TEST_DATABASE_URL=
