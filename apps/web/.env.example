# NEXUS web — environment (§130 one-command dev, §131 never commit secrets)
# Copy to .env.local for overrides. Every value below has a working default in code.

# --- outbound HTTP (documented base URLs; the ONLY places web talks to services) ---
# Spring Boot platform service (commerce core)
PLATFORM_API_BASE_URL=http://127.0.0.1:8080
# FastAPI AI service (search/stream/compare/recommend)
AI_API_BASE_URL=http://127.0.0.1:8000

# Browser-visible copies used by the client stream client
NEXT_PUBLIC_PLATFORM_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:3000

# --- data mode ---
# mock = render the contract-shaped fixtures in src/lib/mock (UI runs with no backend, every
#        card carries flags.demo and shows a DEMO badge)
# live = call PLATFORM/AI through the /api/nexus BFF
NEXT_PUBLIC_DATA_MODE=mock

# --- tenancy + site ---
NEXT_PUBLIC_TENANT=hong-kong
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=zh-HK
NEXT_PUBLIC_DEFAULT_GEO=22.3809,114.1861
NEXT_PUBLIC_GEO_RADIUS_M=3000

# --- proxy behaviour ---
NEXUS_BFF_TIMEOUT_MS=12000

# Session cookie names (set by the platform service; read by the BFF, never by client JS)
NEXUS_SESSION_COOKIE=nexus_session
NEXUS_CSRF_COOKIE=nexus_csrf
NEXT_PUBLIC_CSRF_PARAM=x-csrf-token
