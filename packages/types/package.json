{
  "name": "@nexus/types",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS shared contracts: strict TypeScript types + hand-written JSON Schemas (docs/API_CONTRACT.md, docs/AGENT_CONTRACT.md, infra/db/V1__init.sql).",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    },
    "./schemas/*": "./dist/schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "gen:schemas": "node scripts/gen_schemas.mjs",
    "conformance": "node scripts/validate_conformance.mjs",
    "test:unit": "tsc -p tsconfig.test.json && node --import tsx --test src/tests/enums.test.ts src/tests/schemas.test.ts src/tests/types.test.ts",
    "test": "npm run build && npm run gen:schemas && npm run conformance && npm run test:unit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
